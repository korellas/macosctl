<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>/Users/example</string>
		<key>PATH</key>
		<string>/usr/bin:/bin</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.korellas.demo</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/echo</string>
		<string>hi</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/example/Library/Logs/services/demo.err.log</string>
	<key>StandardOutPath</key>
	<string>/Users/example/Library/Logs/services/demo.out.log</string>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>UserName</key>
	<string>example</string>
	<key>WorkingDirectory</key>
	<string>/Users/example/project</string>
</dict>
</plist>